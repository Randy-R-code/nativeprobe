{
  "expo": {
    "name": "NativeProbe",
    "slug": "nativeprobe",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nativeprobe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.randycode.nativeprobe"
    },
    "android": {
      "package": "com.randycode.nativeprobe",
      "adaptiveIcon": {
        "backgroundColor": "#05080B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NativeProbe uses your location only to demonstrate the Location probe on this screen. It is never stored or sent anywhere."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NativeProbe uses Face ID only to demonstrate the Biometrics probe on this screen."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#05080B"
        }
      ]
    ]
  }
}
