{
  "expo": {
    "name": "NativeProbe",
    "slug": "nativeprobe",
    "version": "0.1.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "nativeprobe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.randycode.nativeprobe"
    },
    "android": {
      "package": "com.randycode.nativeprobe",
      "adaptiveIcon": {
        "backgroundColor": "#05080B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NativeProbe uses your location only to demonstrate the Location probe on this screen. It is never stored or sent anywhere."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NativeProbe uses Face ID only to demonstrate the Biometrics probe on this screen."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#05080B"
        }
      ],
      "./plugins/withoutActivityRecognition"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6589a73-3068-4c12-83b4-c9da21ba13ff"
      }
    },
    "owner": "randy-r-code"
  }
}
